# Copy this file to .env and fill in your key
# Get an API key from https://cloud.llamaindex.ai/api-key
LLAMA_CLOUD_API_KEY=llx-REPLACE_ME

# Giga Token API key – required for giga_token_client.py
# Get your key from https://api.giga-token.com
GIGA_TOKEN_API_KEY=your-api-key

# Optional: override the default model (default: glm-4.5:106b)
GIGA_TOKEN_MODEL=glm-4.5:106b
